{
  "name": "bc-randomizer",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "tsc && biome check .",
    "test": "vitest run",
    "test:fast": "vitest run --exclude 'test/emu-*.test.ts'",
    "test:emu": "vitest run test/emu-",
    "cli": "node src/cli.ts",
    "ending-video": "node scripts/ending-video.ts",
    "dialogue": "node scripts/dialogue.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.5",
    "jsnes": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
